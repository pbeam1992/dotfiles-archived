# Per-account identity lives in the included files, never here.
#
# useConfigOnly stops git guessing an identity from the hostname when no includeIf
# below matches: a repo outside these trees fails to commit instead of quietly
# authoring as pbeamirl@<host>. ~/.ssh/config already routes bitbucket-7peaks,
# bitbucket-appconduct and gitlab-appconduct, none of which have a rule here yet.
[user]
    useConfigOnly = true

[includeIf "gitdir:~/Repositories/github.com/pbeamirl/"]
    path = ~/.config/git/pbeamirl
# jps-laundry is a GitHub org owned by the personal account, so it shares the
# pbeamirl identity and the default github.com SSH key (no URL rewrite needed).
[includeIf "gitdir:~/Repositories/github.com/jps-laundry/"]
    path = ~/.config/git/pbeamirl
[includeIf "gitdir:~/Repositories/github.com/7-peaks-software/"]
    path = ~/.config/git/7peaks

# The 7peaks org lives on a separate GitHub account, so its URLs go through the
# github-7peaks SSH alias. Global (not in the includeIf) because clone runs
# before the target directory — and therefore any gitdir match — exists.
[url "git@github-7peaks:7-peaks-software/"]
    insteadOf = git@github.com:7-peaks-software/

[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
[fetch]
    prune = true
# Refuse to merge on divergence; rebase or merge deliberately instead.
[pull]
    ff = only
[rebase]
    autosquash = true
    updateRefs = true       # stacked branches move together
[diff]
    algorithm = histogram
    colorMoved = default    # moved code is not shown as delete+add
[rerere]
    enabled = true          # remember conflict resolutions across rebases
[merge]
    conflictstyle = zdiff3  # show the common ancestor in conflict hunks
[commit]
    verbose = true          # diff in the commit message editor
[branch]
    sort = -committerdate   # most recently touched branches first
[column]
    ui = auto
[help]
    autocorrect = prompt    # ask before running a typo-corrected command
