#!/bin/sh
# Install tools pinned in the global mise config whenever it changes.
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
#
# `after_`: runs once every file and plain script has been applied, so on a
# fresh machine brew bundle has already installed mise. The guard is a backstop.

set -eu

if command -v mise >/dev/null 2>&1; then
  mise install
fi
